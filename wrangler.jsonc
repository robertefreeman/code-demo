{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-demo-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://robertefreeman.github.io"
  },
  "ratelimits": [
    {
      "name": "PER_IP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "SITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
